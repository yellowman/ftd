#!/bin/ksh
# ftd FastCGI form collector
#
daemon="/usr/local/bin/ftd"
daemon_flags=${ftd_flags:-""}

. /etc/rc.d/rc.subr

rc_bg=YES
rc_reload=NO

: ${ftd_envfile:=/etc/ftd.env}

# rc.subr launches the daemon through `su -l` to apply its login class, and a
# login shell resets the environment. Source the config inside that same shell,
# immediately before exec, so DATABASE_URL (and anything else in ${ftd_envfile})
# actually reaches the process. Loading it in rc_pre or at the top level does
# not work: the su(1) login shell discards those exports before ftd starts.
rc_start() {
	${rcexec} "set -a; [ -r '${ftd_envfile}' ] && . '${ftd_envfile}'; set +a; exec ${daemon} ${daemon_flags}"
}

rc_cmd $1
